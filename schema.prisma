datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["omitApi"]
}

model Employee {
  id            Int      @id @default(autoincrement())
  created_at    DateTime @default(now())
  cpf           String   @unique
  name          String
  work_schedule String
  work_shift    String

  led_departments Department[]          @relation("LeadershipDepartments")
  departments     EmployeeDepartments[]

  work_days Workdays[]

  meal_vouchers MealVoucher[]
}

model Department {
  id         Int      @id @default(autoincrement())
  created_at DateTime @default(now())
  name       String   @unique

  employees EmployeeDepartments[]

  leader    Employee? @relation(name: "LeadershipDepartments", fields: [leader_id], references: [id])
  leader_id Int?
}

model EmployeeDepartments {
  employee      Employee   @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  employee_id   Int
  department    Department @relation(fields: [department_id], references: [id], onDelete: Cascade)
  department_id Int

  @@id([employee_id, department_id])
  @@map("EmployeeDapartments")
}

model Workdays {
  created_at           DateTime @default(now())
  month                Int
  year                 Int
  worked_holidays      Int[]
  worked_weekends      Int[]
  vacation             Int[]
  unjustified_absences Int[]
  worked_6h            Int
  worked_8h            Int
  total_worked_days    Int

  employee    Employee @relation(fields: [employee_id], references: [id])
  employee_id Int

  MealVoucher MealVoucher?

  @@id([employee_id, month, year])
}

model MealVoucher {
  created_at                          DateTime @default(now())
  month                               Int
  year                                Int
  total_value_6h                      Float
  total_value_8h                      Float
  total_discount_6h                   Float
  total_discount_8h                   Float
  total_discount                      Float
  total_days_6h_discounted            Float
  total_days_8h_discounted            Float
  total_days_discounted               Float
  unjustified_absences_previous_month Int[]
  amount                              Float

  employee    Employee @relation(fields: [employee_id], references: [id])
  employee_id Int

  work_days Workdays @relation(fields: [employee_id, month, year], references: [employee_id, month, year])

  @@id([employee_id, month, year])
}

model Configs {
  key   String @id
  value String
  type  String
}
